PORT=5000
NODE_ENV=development

# ==============================================================================
# REAL INBOX EMAIL DELIVERY CONFIGURATION (Nodemailer)
# ==============================================================================
# HOW THIS WORKS:
# 1. GMAIL_USER below is your application's SENDER account (like Netflix/Spotify's no-reply).
# 2. You only configure this ONCE on the server.
# 3. Once set, the server will send the real OTP email to ANY user/customer
#    who enters their own Gmail ID into the login form!
# ==============================================================================

# THE SERVER SENDER ACCOUNT:
# Step 1: Turn on 2-Step Verification: https://myaccount.google.com/security
# Step 2: Generate a 16-character App Password: https://myaccount.google.com/apppasswords
# Step 3: Put your sender Gmail and the 16-letter App Password below:
GMAIL_USER=
GMAIL_APP_PASSWORD=


# (Optional) CUSTOM SMTP PROVIDER (Brevo, SendGrid, Mailgun, Amazon SES):
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Vusic Studio <no-reply@vusicrecords.com>
